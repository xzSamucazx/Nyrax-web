# Copie para as variáveis de ambiente do provedor de hospedagem.
NODE_ENV=production
PORT=3000
DATABASE_URL=postgresql://USUARIO:SENHA@HOST:5432/BANCO
# Gere um segredo aleatório com pelo menos 32 caracteres. Nunca publique este valor.
SESSION_SECRET=SUBSTITUA_POR_UM_SEGREDO_ALEATORIO_LONGO
# Opcional, somente se seu provedor exigir SSL diferente do padrão:
# PGSSLMODE=disable
